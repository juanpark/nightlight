rules_version = '2';
// Browsers may only read their own data. Every write goes through the API (Admin SDK), never the client.
service cloud.firestore {
  match /databases/{database}/documents {
    // A live demo machine's pool account is known by uid (livePoolUids/{uid} -> its slot, written by the API), not by
    // token claims: it reads only with a token for that slot's current lease (leased, not wiping, before both of its
    // deadlines). A login linked to the account, or a token from an earlier visit, reads nothing.
    function poolSlot(uid) {
      return /databases/$(database)/documents/livePoolUids/$(uid);
    }
    function leaseOk(uid) {
      let slot = get(poolSlot(uid)).data.slot;
      let s = get(/databases/$(database)/documents/livePool/$(slot)).data;
      return request.auth.token.get('nl_slot', '') == slot
        && s.get('state', '') == 'leased'
        && s.get('leaseId', '') == request.auth.token.get('nl_lease', '-')
        && s.get('wiping', false) == false
        && s.expiresAt > request.time
        && s.hardExpiresAt > request.time;
    }
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid
        && (!exists(poolSlot(uid)) || leaseOk(uid));
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
